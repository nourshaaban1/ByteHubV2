# Origin of the ByteHub Express API. Next proxies /api/v1 and /Catalog here,
# so the browser only ever makes same-origin requests.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Path the client calls. Leave as-is to use the proxy above; point it at an
# absolute URL only if you are bypassing the proxy deliberately.
NEXT_PUBLIC_API_BASE=/api/v1
