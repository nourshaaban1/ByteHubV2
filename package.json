{
  "name": "bytehub",
  "version": "1.0.0",
  "description": "ByteHub \u2014 online storefront for hardware and mobile accessories, and the catalog API behind it",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "shop": "npm --prefix apps/storefront run dev",
    "shop:build": "npm --prefix apps/storefront run build",
    "shop:start": "npm --prefix apps/storefront run start",
    "catalog": "node scripts/import-catalog.js",
    "publish": "node scripts/publish-catalog.js",
    "import": "node scripts/import.js",
    "link:images": "node scripts/link-images.js",
    "backfill:status": "node scripts/backfill-status.js",
    "test": "vitest run",
    "test:shop": "npm --prefix apps/storefront run test",
    "test:all": "npm run test && npm run test:shop",
    "smoke": "node scripts/smoke.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.0.0",
    "vitest": "^2.0.5"
  }
}
