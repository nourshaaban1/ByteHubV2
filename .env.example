# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/bytehub

# ---- Admin auth ----
# Comma-separated list of accepted admin API keys.
# Leave blank in development to disable auth entirely.
ADMIN_API_KEYS=

# ---- Currency ----
# Reporting currency that all analytics roll up into.
BASE_CURRENCY=EGP
# 1 USD = ? EGP. Used to normalise the USD-priced generic catalog.
USD_TO_EGP_RATE=48.5

# ---- Pricing policy (percent, cost basis: (selling - rdp) / rdp) ----
MARGIN_TARGET_PCT=54
MARGIN_WARN_PCT=25
MARGIN_CRITICAL_PCT=10

# ---- Data quality ----
QUALITY_MIN_PUBLISHABLE=70

# ---- Ingestion ----
CATALOG_IMAGE_ROOT=./Catalog
IMPORT_BATCH_SIZE=250
