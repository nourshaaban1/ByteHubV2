# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Public URL of the storefront. Canonical links and the sitemap resolve
# against it, so in production this must be the real https origin.
SITE_URL=http://localhost:3001

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/bytehub

# ---- Back office ----
# The admin, pricing, quality and analytics routes. The shop needs none of
# them and the catalog is managed from the CLI, so they are off by default in
# production and on by default here. Turning them on in production without
# ADMIN_API_KEYS makes the server refuse to start.
ENABLE_ADMIN_API=true

# Comma-separated list of accepted admin API keys.
# Leave blank in development to disable auth entirely.
ADMIN_API_KEYS=

# ---- CORS ----
# Comma-separated allowlist of browser origins. Blank means same-origin only,
# which is correct when Next proxies the API. "*" is refused in production.
CORS_ORIGINS=

# ---- Currency ----
# Reporting currency that all analytics roll up into.
BASE_CURRENCY=EGP
# 1 USD = ? EGP. Used to normalise the USD-priced generic catalog.
USD_TO_EGP_RATE=48.5

# ---- Pricing policy (percent, cost basis: (selling - rdp) / rdp) ----
MARGIN_TARGET_PCT=54
MARGIN_WARN_PCT=25
MARGIN_CRITICAL_PCT=10

# ---- Data quality ----
QUALITY_MIN_PUBLISHABLE=70

# ---- Ingestion ----
# Where product photos live on disk.
CATALOG_IMAGE_ROOT=./New Catalog
# Stable URL prefix they are served under. Deliberately not the folder name:
# that directory has been renamed once already, and every stored image URL
# would have broken with it.
CATALOG_IMAGE_PUBLIC_PATH=/catalog
IMPORT_BATCH_SIZE=250
