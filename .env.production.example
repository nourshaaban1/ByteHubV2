# ByteHub — production environment.
# Copy to .env and fill in. `docker compose up` reads this file.

# Public URL of the shop. Canonical links, the sitemap and every Open Graph
# image resolve against it, so it must be the real https origin.
SITE_URL=https://shop.bytehub.eg

# Host port the storefront binds to.
PORT=3001

# Only needed if the shop and the API are served from different hosts. Left
# empty the storefront proxies the API and the browser stays same-origin.
CORS_ORIGINS=

# 1 USD = ? EGP. Used to normalise the USD-priced archive rows for comparison.
USD_TO_EGP_RATE=48.5

# ---- Shop contact details (shown on the site, used by the WhatsApp link) ----
# Digits only, international format. WhatsApp rejects '+' and spaces.
WHATSAPP=201044100855
PHONE=+20 10 4410 0855
EMAIL=hello@bytehub.eg
ADDRESS=Cairo, Egypt

# ---- Back office ------------------------------------------------------------
# The deployed stack keeps these off: the storefront needs only the public
# catalog endpoints, and the catalog is managed from the CLI. Turning them on
# without ADMIN_API_KEYS makes the server refuse to start.
# ENABLE_ADMIN_API=true
# ADMIN_API_KEYS=generate-a-long-random-string,and-another
