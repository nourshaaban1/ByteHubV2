# Where the ByteHub backend is listening. Next proxies /api/v1 and /Catalog
# here, so the browser only ever talks to the storefront's own origin.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Shop contact details, shown in the footer and on the "Contact to buy" button.
# Digits only, full international format, no '+' or spaces.
NEXT_PUBLIC_WHATSAPP=201044100855
NEXT_PUBLIC_PHONE=+20 10 4410 0855
NEXT_PUBLIC_EMAIL=hello@bytehub.eg
NEXT_PUBLIC_ADDRESS=Cairo, Egypt
